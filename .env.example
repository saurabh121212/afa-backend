# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file to Git.

# ---- App ----
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=afa_db
DB_USER=root
DB_PASSWORD=your_mysql_password

# ---- File uploads (local disk) ----
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# ---- CORS (comma-separated list of allowed frontend URLs) ----
CORS_ORIGINS=http://localhost:3000


# ---- Default admin (created by: npm run db:seed) ----
ADMIN_NAME=AFA Super Admin
ADMIN_EMAIL=admin@afa.co.sz
ADMIN_PHONE=
ADMIN_PASSWORD=YourStrongPassword

# ---- JWT ----
JWT_SECRET=paste_your_generated_secret_here
JWT_EXPIRES_IN=1d


DATA_ENCRYPTION_KEY=<the 64 characters it printed>

JWT_REMEMBER_ME_EXPIRES_IN=30d
JWT_REGISTRATION_EXPIRES_IN=24h

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_afa_account@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM=AFA <your_afa_account@gmail.com>

OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60


# ---- Payments (Phase 3) ----
# none = only bank transfer is offered; test = fake online gateway for development (never in production)
PAYMENT_GATEWAY=test
PAYMENT_RETURN_URL=http://localhost:3000/checkout/result
PAYMENT_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ---- ePayNet (used when PAYMENT_GATEWAY=epaynet) ----
# Values from ePayNet onboarding. Never put these in the frontend.
EPAYNET_URL=https://www.epaynetsz.com/bridge_gateway/bridge_receive_getway_transaction.php
EPAYNET_API_KEY=
EPAYNET_APP_ID=
EPAYNET_THREEC=
EPAYNET_TWOC=
EPAYNET_C=
EPAYNET_UID=
EPAYNET_PASSWORD=
# Payment options enabled for AFA: 1 MoMo, 2 eMali, 3 Unayo, 5 Visa/Mastercard, 9 Nedbank, 13 OTT Voucher, 15 ePayNet Token
EPAYNET_METHODS=1,2,5
# form (as in the ePayNet Postman example) or json
EPAYNET_REQUEST_FORMAT=form
EPAYNET_TIMEOUT_MS=20000
# Callback URL to register with ePayNet: https://<your-api>/api/v1/payments/webhooks/epaynet/<EPAYNET_CALLBACK_TOKEN>
EPAYNET_CALLBACK_TOKEN=change-me-to-a-long-random-string
# Comma-separated ePayNet server IPs (ask ePayNet). Empty = not checked
EPAYNET_ALLOWED_IPS=
# true = after the callback, send the buyer's browser on to PAYMENT_RETURN_URL
EPAYNET_CALLBACK_REDIRECT=true

# Behind nginx / a load balancer set TRUST_PROXY=1 (real client IPs)
TRUST_PROXY=

# ---- Background jobs (auto-cancel unpaid orders, complete delivered orders) ----
RUN_JOBS=true
